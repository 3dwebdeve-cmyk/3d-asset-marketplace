# Backup host secrets. Copy to .env.backup on the backup host and `chmod 600 .env.backup`.
# Read only by backend/scripts/backup_postgres.sh; Compose never loads this file, so the
# app containers cannot see the backup key. The app refuses to start on staging/production
# if R2_BACKUP_SECRET_ACCESS_KEY is in its environment. See docs/BACKUP_RESTORE_DRILL.md.

# age public key (age1...). Backups are encrypted to it; the private key stays offline.
BACKUP_AGE_RECIPIENT=

# Separate backup bucket with a 30-day lock rule, and its own R2 token
# (Object Read & Write on the private and backup buckets). Never the app's key.
R2_BACKUP_BUCKET=
R2_BACKUP_ACCESS_KEY_ID=
R2_BACKUP_SECRET_ACCESS_KEY=

# Optional disposable bucket for object restore drills.
R2_RESTORE_DRILL_BUCKET=
