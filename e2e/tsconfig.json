{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "moduleDetection": "force",
    "isolatedModules": true,
    "typeRoots": ["./node_modules/@types"]
  },
  "include": ["playwright.config.ts", "helpers/**/*.ts", "tests/**/*.ts"]
}
