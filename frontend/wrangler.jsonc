{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "3d-asset-marketplace",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-06",
  "keep_vars": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*"]
  }
}
