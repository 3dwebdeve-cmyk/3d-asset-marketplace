{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "3d-asset-marketplace",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-06",
  "keep_vars": true,
  // The shop lives on its own domain (a Custom Domain set in the dashboard). Without this, every
  // deploy switches the <name>.<subdomain>.workers.dev address back on: a full second copy of the
  // shop and API outside the domain's Cloudflare rules. Preview links of new versions stay on.
  "workers_dev": false,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api",
      "/api/*",
      "/robots.txt",
      "/sitemap.xml",
      "/",
      "/3d-models",
      "/3d-models/*",
      "/plugins",
      "/categories",
      "/about",
      "/contact",
      "/custom-projects",
      "/terms",
      "/privacy",
      "/products/*",
      "/Products/*",
      "/plugins/*",
      "/Plugins/*"
    ]
  },
  "vars": {
    "SITE_URL": "https://assethive3d.com"
  }
}
