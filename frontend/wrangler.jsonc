{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "3d-asset-marketplace",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-06",
  "keep_vars": true,
  // The shop lives on its own domain (a Custom Domain set in the dashboard). Without this, every
  // deploy switches the <name>.<subdomain>.workers.dev address back on: a full second copy of the
  // shop and API outside the domain's Cloudflare rules. Preview links of new versions stay on.
  "workers_dev": false,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Every page goes through the Worker, so unknown addresses answer 404 (worker/routes.ts) and
    // catalog pages get their own title. Static file folders are served directly; anything missed
    // here still works, it only costs a Worker request.
    "run_worker_first": [
      "/*",
      "!/assets/*",
      "!/_webp/*",
      "!/fonts/*",
      "!/images/*",
      "!/models/*",
      "!/hdri/*",
      "!/fixtures/*",
      "!/banner image/*",
      "!/catego image/*",
      "!/custome project image/*",
      "!/homepage images/*",
      "!/favicon.svg",
      "!/og-default.jpg"
    ]
  },
  "vars": {
    "SITE_URL": "https://assethive3d.com"
  }
}
