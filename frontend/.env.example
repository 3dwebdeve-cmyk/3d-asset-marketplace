# Empty = same-origin `/api/v1` via Vite proxy (local) or Nginx (Docker).
# Required for httpOnly refresh cookies (SameSite=Lax). Prefer empty over a
# cross-origin absolute URL like http://127.0.0.1:8000.
# Pair backend CORS_ALLOWED_ORIGINS / FRONTEND_BASE_URL when using a separate API host.
# Canonical API prefix is /api/v1/; legacy /api/ aliases remain on the backend for one release.
VITE_API_BASE_URL=

# Google Sign-In Web client ID (same value as backend GOOGLE_OAUTH_CLIENT_ID).
VITE_GOOGLE_CLIENT_ID=

# Sentry browser DSN (optional). Create a separate React project at sentry.io.
# VITE_SENTRY_DSN=
# VITE_SENTRY_ENVIRONMENT=development
# VITE_SENTRY_TRACES_SAMPLE_RATE=0
