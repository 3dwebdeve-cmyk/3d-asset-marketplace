# Empty = same-origin `/api/v1` via Vite proxy (local) or Nginx (Docker).
# Required for httpOnly refresh cookies (SameSite=Lax) after Stripe returns.
# Do NOT point this at http://127.0.0.1:8000 while the SPA is on localhost:5173 —
# that cross-origin setup drops the refresh cookie on XHR and logs users out after pay.
# Pair backend CORS_ALLOWED_ORIGINS / FRONTEND_BASE_URL when using a separate API host.
# Canonical API prefix is /api/v1/; legacy /api/ aliases remain on the backend for one release.
VITE_API_BASE_URL=

# Google Sign-In Web client ID (same value as backend GOOGLE_OAUTH_CLIENT_ID).
# Required for the Google button; leave blank to hide/disable client-side Google Sign-In.
# Restart `npm run dev` (or rebuild the frontend image) after changing this.
VITE_GOOGLE_CLIENT_ID=

# Sentry browser DSN (optional). Create a separate React project at sentry.io.
# Bake at build — see docs/SENTRY_STAGING_CHECKLIST.md
# VITE_SENTRY_DSN=
# VITE_SENTRY_ENVIRONMENT=development
# VITE_SENTRY_TRACES_SAMPLE_RATE=0
