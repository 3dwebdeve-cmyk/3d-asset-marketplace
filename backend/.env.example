# Copy into backend/.env (never commit real secrets).

SECRET_KEY=
DEBUG=True
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
PUBLIC_API_BASE_URL=http://127.0.0.1:8000
FRONTEND_BASE_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Cloudflare R2 (Feature 14). Leave blank to keep local MEDIA_ROOT.
# R2_ENABLED is derived: all of the following must be set.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_PUBLIC_BUCKET=3dam-public
R2_PRIVATE_BUCKET=3dam-private
R2_PUBLIC_BASE_URL=https://pub-xxxxxxxx.r2.dev
R2_SIGNED_URL_EXPIRY=300
