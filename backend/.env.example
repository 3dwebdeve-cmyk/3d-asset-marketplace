# Copy into backend/.env (never commit real secrets).
# Local teammate setup: DEBUG=True, console email, no Redis, R2 optional.

# --- Core ---
# SECRET_KEY must be at least 32 bytes (HS256 JWT).
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-bytes
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# --- PostgreSQL ---
DB_NAME=marketplace
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Public origin of this API (used to build local /media/ URLs when R2 is unset).
PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Must match the Vite origin teammates open in the browser.
# Verification and password-reset emails use this host. Keep localhost vs 127.0.0.1 consistent
# with CORS_ALLOWED_ORIGINS and frontend/.env VITE_API_BASE_URL pairing.
FRONTEND_BASE_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Email ---
# DEBUG default in settings: print mail (including verification links) to the backend terminal.
# With DEBUG=True you can also copy the labeled "EMAIL VERIFICATION LINK" log line.
# Bypass for local teammates:
#   python manage.py verify_email you@example.com
#   or Django admin → Users → email_verified, or SPA /admin/users/:id
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@3dassetmarketplace.local
# Production SMTP (unused while EMAIL_BACKEND is console):
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
# Comma-separated inboxes for custom-project staff alerts and the public contact form.
PROJECT_MESSAGE_ADMIN_RECIPIENTS=
CONTACT_ADMIN_RECIPIENTS=

# --- Stripe (sandbox for local checkout) ---
# Leave blank to browse the catalog; checkout returns an error until these are set.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Redis ---
# Required only when DEBUG=False (shared cache / DRF throttles across workers).
# Leave blank for local DEBUG=True — LocMemCache is used.
REDIS_URL=

# --- Meilisearch ---
# Optional public catalog search. Leave blank to keep PostgreSQL icontains.
# Local: docker compose up meilisearch
# MEILI_URL=http://127.0.0.1:7700
MEILI_URL=
MEILI_MASTER_KEY=dev_master_key_change_me

# --- Cloudflare R2 (Feature 14). Optional locally. ---
# Leave blank to keep files on local MEDIA_ROOT.
# R2_ENABLED is derived: all of the following must be set (except tests, which force R2 off).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_PUBLIC_BUCKET=3dam-public
R2_PRIVATE_BUCKET=3dam-private
R2_PUBLIC_BASE_URL=https://pub-xxxxxxxx.r2.dev
R2_SIGNED_URL_EXPIRY=300
# After R2 is enabled, leftover local MEDIA can be copied with:
#   python manage.py migrate_local_media_to_r2 --dry-run
#   python manage.py migrate_local_media_to_r2

# --- Production-only (DEBUG=False) ---
# CSRF_TRUSTED_ORIGINS=https://your-frontend.example,https://api.example
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
