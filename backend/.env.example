# Copy into backend/.env (never commit real secrets).
# Local teammate setup: DEBUG=True, console email, no Redis, R2 optional.

# --- Core ---
# SECRET_KEY must be at least 32 bytes (HS256 JWT).
# Staging/prod: never keep the example string — openssl rand -base64 48
# Gate: manage.py check_deploy_config --fail-on-warnings (docs/DEPLOY_SECRETS_STAGING_CHECKLIST.md)
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-bytes
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# --- PostgreSQL ---
DB_NAME=marketplace
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
# Phase A5 backups (ops scripts on host / Compose — not Django settings):
#   ../backend/scripts/backup_postgres.sh  (from repo root: ./backend/scripts/…)
#   BACKUP_UPLOAD_R2=1 BACKUP_RETENTION_DAYS=14 ./backend/scripts/backup_postgres.sh
#   ./backend/scripts/restore_postgres_drill.sh ./backups/marketplace-….dump
#   RESTORE_DRILL_MODE=local|docker|auto
#   ./backend/scripts/install_backup_cron.sh
# See docs/BACKUP_RESTORE_DRILL.md
# Optional: reuse DB connections across requests (seconds). 0 during manage.py test.
# DB_CONN_MAX_AGE=60

# Public origin of this API (used to build local /media/ URLs when R2 is unset).
PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Must match the Vite origin teammates open in the browser.
# Verification and password-reset emails use this host. Keep localhost vs 127.0.0.1 consistent
# with CORS_ALLOWED_ORIGINS and frontend/.env VITE_API_BASE_URL pairing.
# Staging/prod: https://<public-spa-origin> — see docs/AUTH_STAGING_CHECKLIST.md
# When DEBUG=False, localhost FRONTEND_BASE_URL is refused unless ALLOW_LOCALHOST_FRONTEND=True.
ALLOW_LOCALHOST_FRONTEND=True
FRONTEND_BASE_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Google Sign-In (same Web client ID as frontend VITE_GOOGLE_CLIENT_ID).
# Leave blank to disable Google button server-side. Optional for launch if unused.
GOOGLE_OAUTH_CLIENT_ID=

# --- Email ---
# DEBUG default in settings: print mail (including verification links) to the backend terminal.
# With DEBUG=True you can also copy the labeled "EMAIL VERIFICATION LINK" log line.
# Bypass for local teammates:
#   python manage.py verify_email you@example.com
#   or Django admin → Users → email_verified, or SPA /admin/users/:id
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@3dassetmarketplace.local
# Staging/prod SMTP — see docs/SMTP_STAGING_CHECKLIST.md
# (unused while EMAIL_BACKEND is console):
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# ALLOW_CONSOLE_EMAIL=False
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
# Comma-separated inboxes for custom-project staff alerts and the public contact form.
# Required for launch (DEBUG=False): check_ops_config --fail-on-warnings.
# Local example: admin@marketplace.local (or your real ops inbox).
PROJECT_MESSAGE_ADMIN_RECIPIENTS=
CONTACT_ADMIN_RECIPIENTS=

# --- Stripe (sandbox for local checkout — see docs/STRIPE_SANDBOX_CHECKLIST.md) ---
# Use sk_test_ / pk_test_ only until production cutover. Leave blank to browse without checkout.
# Operator: python manage.py check_stripe_config --require-test-mode --fail-on-warnings [--ping] [--smoke-fulfill]
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Browser E2E only (Compose overlay / CI). Never enable with sk_live_ keys.
# E2E_STRIPE_SIMULATE=True
# LEGAL_TERMS_VERSION=2026-09-18
# LEGAL_PRIVACY_VERSION=2026-09-18

# --- Sentry (optional; leave blank until you create a Django project at sentry.io) ---
# See docs/SENTRY_STAGING_CHECKLIST.md — manage.py check_sentry_config [--send-test-event]
# Client keys are public DSNs; still do not commit real production values if you prefer.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
# SENTRY_RELEASE=3d-asset-marketplace@1.0.0
# 0.0 disables performance tracing locally; use ~0.1 in production.
SENTRY_TRACES_SAMPLE_RATE=0.0

# --- Redis / Celery ---
# Required when DEBUG=False (shared cache / DRF throttles).
# Leave blank for local DEBUG=True — LocMemCache + CELERY_TASK_ALWAYS_EAGER.
# Docker Compose: REDIS_URL=redis://redis:6379/1 (cache), CELERY_BROKER_URL=…/0 (broker).
# Staging/prod: REDIS_PASSWORD=… (injected into URLs that have no password).
# Worker: celery -A config worker --loglevel=info
REDIS_URL=
# CELERY_BROKER_URL=redis://127.0.0.1:6379/0

# Local DEBUG=False + console mail only when explicitly allowed:
# ALLOW_CONSOLE_EMAIL=True
# ALLOW_LOCALHOST_FRONTEND is set near FRONTEND_BASE_URL above for local DX.

# --- Meilisearch ---
# Local DX (DEBUG=True): leave blank to use PostgreSQL icontains fallback.
# Production (DEBUG=False): MEILI_REQUIRED defaults true — set MEILI_URL or healthz/search fail.
# Local Meilisearch-only: docker compose up meilisearch
# Full stack: docker compose up --build  (MEILI_URL=http://meilisearch:7700)
# Compose meilisearch service: MEILI_ENV=production (root .env; not a Django setting).
# Staging/prod: python manage.py check_search_config --fail-on-warnings
#               python manage.py reindex_search
# MEILI_URL=http://127.0.0.1:7700
MEILI_URL=
MEILI_MASTER_KEY=dev_master_key_change_me
# MEILI_REQUIRED=true
# MEILI_REQUIRED=false

# --- Cloudflare R2 (Feature 14). Optional locally. ---
# Leave blank to keep files on local MEDIA_ROOT.
# R2_ENABLED is derived: all of the following must be set (except tests, which force R2 off).
# Staging/prod: create BOTH buckets, then see docs/R2_STAGING_CHECKLIST.md
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_PUBLIC_BUCKET=3dam-public
R2_PRIVATE_BUCKET=3dam-private
R2_PUBLIC_BASE_URL=https://pub-xxxxxxxx.r2.dev
R2_SIGNED_URL_EXPIRY=300
# After R2 is enabled:
#   python manage.py verify_r2
#   python manage.py verify_r2 --smoke-presign
#   python manage.py migrate_local_media_to_r2 --dry-run
#   python manage.py migrate_local_media_to_r2
#   python manage.py audit_published_packages --fail-on-missing
# Compose: also set the same R2_* in repo-root .env (web + worker), then recreate.

# --- JWT refresh cookie (httpOnly; never returned in JSON) ---
# JWT_REFRESH_COOKIE_NAME=refresh_token
# JWT_REFRESH_REMEMBER_COOKIE_NAME=refresh_remember
# Path scoped to auth routes (legacy /api/ aliases removed).
# JWT_REFRESH_COOKIE_PATH=/api/v1/auth/
# JWT_REFRESH_COOKIE_SAMESITE=Lax
# Leave unset to derive Secure from DEBUG; set True behind HTTPS reverse proxy.
# JWT_REFRESH_COOKIE_SECURE=

# --- Legal document versions (register + checkout) ---
# LEGAL_TERMS_VERSION=2026-09-18
# LEGAL_PRIVACY_VERSION=2026-09-18

# --- Production-only (DEBUG=False) ---
# See docs/DEPLOY_SECRETS_STAGING_CHECKLIST.md + docs/PRODUCTION_CHECKLIST.md §1
# CSRF_TRUSTED_ORIGINS=https://your-frontend.example,https://api.example
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
# ALLOW_LOCALHOST_FRONTEND=False
# ALLOW_CONSOLE_EMAIL=False
# Root Compose wires CSRF_TRUSTED_ORIGINS + SECURE_HSTS_SECONDS (local HSTS default 0).
# CORS_ALLOW_CREDENTIALS is True in settings (cookie refresh). Keep SPA origins in CORS_ALLOWED_ORIGINS.
# Do not publish Postgres / Redis / Meilisearch / Gunicorn ports publicly.
#
# Full Docker stack (Feature 13): copy repo-root `.env.example` → `.env`, then
#   docker compose up --build
# Web image bakes DEBUG=False; secrets stay in env / Compose env_file only.
#
# Production host cutover (SMTP, Stripe, R2, Sentry, check --deploy, backup,
# webhook, worker/mail, rollback): docs/PRODUCTION_CHECKLIST.md
# Phase K2 rollback rehearsal: docs/ROLLBACK_REHEARSAL.md
#   manage.py check_rollback_rehearsal --profile staging
#   scripts/rollback_compose.sh|.ps1 (previous WEB_IMAGE / FRONTEND_IMAGE)
#   python manage.py check_deploy_config --fail-on-warnings
#   python manage.py check --deploy
