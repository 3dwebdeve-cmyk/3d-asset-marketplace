# Root Compose env for Feature 13 (copy to `.env` — never commit real secrets).
# Used by docker compose; backend also reads these as process environment.
#
# Production cutover: follow docs/PRODUCTION_CHECKLIST.md
# (DEBUG=False, real SECRET_KEY, Redis, SMTP, Stripe, both R2 buckets, Sentry, TLS at proxy,
# check --deploy, backup drill, webhook test, worker + mail, rollback policy).

# --- Django / Gunicorn (web image forces DEBUG=False) ---
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-bytes
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,web,frontend
# Comma-separated origins the SPA is served from (email links + CORS if API is on another host).
FRONTEND_BASE_URL=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
PUBLIC_API_BASE_URL=http://localhost:8080
# Local Compose is HTTP; set True only behind real TLS (Cloudflare / load balancer).
SECURE_SSL_REDIRECT=False
# CSRF_TRUSTED_ORIGINS=https://your-domain.example
# SECURE_HSTS_SECONDS=31536000

# --- PostgreSQL ---
DB_NAME=marketplace
DB_USER=marketplace
DB_PASSWORD=change-me-db-password
DB_HOST=postgres
DB_PORT=5432

# --- Redis (required when DEBUG=False; also Celery broker) ---
REDIS_URL=redis://redis:6379/1

# --- Meilisearch ---
MEILI_URL=http://meilisearch:7700
MEILI_MASTER_KEY=change-me-meili-master-key-at-least-16-chars
MEILI_ENV=production

# Frontend build args (empty VITE_API_BASE_URL = same-origin /api via Nginx; required for httpOnly refresh cookies)
FRONTEND_PORT=8080
VITE_API_BASE_URL=
VITE_GOOGLE_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_ID=

# --- Email (console by default; production MUST use SMTP — see PRODUCTION_CHECKLIST) ---
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@3dassetmarketplace.local
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
PROJECT_MESSAGE_ADMIN_RECIPIENTS=
CONTACT_ADMIN_RECIPIENTS=

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Browser E2E / Compose overlay only. Never set with sk_live_ keys.
# E2E_STRIPE_SIMULATE=True

# --- Sentry (optional; create separate Django + React projects at sentry.io) ---
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1
# Frontend DSN is baked at image build time (Vite).
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=production
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1

# --- Cloudflare R2 (recommended in Compose; leave blank only for API-only smoke tests) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT_URL=
R2_PUBLIC_BUCKET=3dam-public
R2_PRIVATE_BUCKET=3dam-private
R2_PUBLIC_BASE_URL=
R2_SIGNED_URL_EXPIRY=300
