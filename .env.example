# Root Compose env for Feature 13 (copy to `.env` — never commit real secrets).
# Used by docker compose; backend also reads these as process environment.
#
# Production cutover: follow docs/PRODUCTION_CHECKLIST.md + docs/CUTOVER_STAGING_CHECKLIST.md
# (DEBUG=False, real SECRET_KEY, SMTP, Stripe, both R2 buckets, Sentry, TLS at proxy,
# check_cutover / check --deploy, backup drill, webhook test, rollback policy).
#
# Immutable image tags (Compose image: names — do not rely on :latest for rollback):
#   ./backend/scripts/build_immutable_images.sh   # or backend/scripts/build_immutable_images.ps1
#   # exports WEB_IMAGE / FRONTEND_IMAGE / IMAGE_TAG / SENTRY_RELEASE
# WEB_IMAGE=marketplace-web:local
# FRONTEND_IMAGE=marketplace-frontend:local
# IMAGE_TAG=local
# Gate: docker compose exec web python manage.py check_cutover --profile staging --fail-on-warnings
# Rollback (Phase K2): keep previous WEB_IMAGE/FRONTEND_IMAGE + previous .env version;
#   PREVIOUS_WEB_IMAGE=… PREVIOUS_FRONTEND_IMAGE=… ./backend/scripts/rollback_compose.sh
#   docker compose exec web python manage.py check_rollback_rehearsal --profile staging
#   Runbook: docs/ROLLBACK_REHEARSAL.md

# --- Django / Gunicorn (web image forces DEBUG=False) ---
# Phase A2: replace placeholders before staging/prod — see docs/DEPLOY_SECRETS_STAGING_CHECKLIST.md
# Generate: openssl rand -base64 48
# Never ship the example SECRET_KEY (check_deploy_config / check --deploy will fail).
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-bytes
# Administrator two-factor sign-in (docs/AUTH_STAGING_CHECKLIST.md). Authenticator secrets
# are derived from MFA_SECRET_KEY; set a separate long random value so rotating SECRET_KEY
# does not reset every administrator. Required on (and cannot be turned off for) staging/production.
MFA_SECRET_KEY=
ADMIN_MFA_REQUIRED=True
ADMIN_SESSION_MAX_HOURS=8
# Reject passwords found in known breaches (only a 5-character hash prefix is sent).
PASSWORD_BREACH_CHECK=True
DEBUG=False
# Local Compose: localhost + service names. Staging/prod: public hostname(s) only (no *).
ALLOWED_HOSTS=localhost,127.0.0.1,web,frontend
# Comma-separated origins the SPA is served from (email links + CORS if API is on another host).
# Production: https://<public-spa-origin> — see docs/AUTH_STAGING_CHECKLIST.md
FRONTEND_BASE_URL=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
PUBLIC_API_BASE_URL=http://localhost:8080
# Local Compose is HTTP; set True only behind real TLS (Cloudflare / load balancer).
SECURE_SSL_REDIRECT=False
# Required when DEBUG=False on a public host (https://… SPA/API origins):
# CSRF_TRUSTED_ORIGINS=https://your-domain.example
# After HTTPS works end-to-end (cookies become Secure):
# SECURE_HSTS_SECONDS=31536000
# Compose defaults SECURE_HSTS_SECONDS=0 for local HTTP; set 31536000 on staging/prod.
# When DEBUG=False, localhost FRONTEND is refused unless ALLOW_LOCALHOST_FRONTEND=True.
# Local Compose / CI e2e must set this; staging/prod must leave it False/unset.
ALLOW_LOCALHOST_FRONTEND=True
# Staging/prod gate: manage.py check_deploy_config --fail-on-warnings
#                   manage.py check_deploy_config --django-deploy-check --fail-on-warnings
#                   manage.py check --deploy
# Operator runbook: docs/DEPLOY_SECRETS_STAGING_CHECKLIST.md
# Never commit the host `.env`. Restart web after changing secrets/hosts.

# --- PostgreSQL ---
DB_NAME=marketplace
DB_USER=marketplace
# Replace before staging/prod (not the example string; ≥12 chars).
DB_PASSWORD=change-me-db-password
# Staging/production: provision a distinct DML-only role, then set all four.
# Run backend/scripts/provision_runtime_role.py with migration credentials.
# DB_MIGRATION_USER=marketplace
# DB_MIGRATION_PASSWORD=<separate migration password>
# DB_RUNTIME_USER=marketplace_runtime
# DB_RUNTIME_PASSWORD=<unique runtime password>
DB_HOST=postgres
DB_PORT=5432
# Backups (ops scripts on the host — not Django settings). See docs/BACKUP_RESTORE_DRILL.md
#   BACKUP_UPLOAD_R2=1 BACKUP_RETENTION_DAYS=30 ./backend/scripts/backup_postgres.sh
#   BACKUP_AGE_IDENTITY=<offline key file> ./backend/scripts/restore_postgres_drill.sh ./marketplace-….dump.age
#   ./backend/scripts/install_backup_cron.sh   # Linux host crontab (idempotent)
# Backup secrets go in .env.backup (copy .env.backup.example), NOT here: Compose loads
# this file into the app containers, and the app must never hold the backup key.

# Redis is not used (LocMem cache + eager Celery + Postgres search).
# Public host: disable Django /admin/ (SPA is /console/) or set staff CIDRs.
# DJANGO_ADMIN_ENABLED=False
# DJANGO_ADMIN_ALLOWED_IPS=10.0.0.0/8
# Lock SPA console APIs to company network / VPN egress (comma-separated IPs or CIDRs).
# Empty locally. Staging/prod example (replace with your office + VPN ranges):
# ADMIN_CONSOLE_ALLOWED_IPS=203.0.113.0/24,198.51.100.50

# Frontend build args (empty VITE_API_BASE_URL = same-origin /api via Nginx; required for httpOnly refresh cookies)
# SPA administrator panel: /console (not /admin — /admin is Django admin via Nginx).
FRONTEND_PORT=8080
VITE_API_BASE_URL=
# Same Web client ID as GOOGLE_OAUTH_CLIENT_ID (leave both blank to disable Google Sign-In).
VITE_GOOGLE_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_ID=

# --- Email (console by default; staging/prod: Brevo API or SMTP) ---
# Render free blocks SMTP ports — set BREVO_API_KEY (Brevo → API keys, not SMTP key).
# BREVO_API_KEY=
BREVO_SENDER_NAME=3D Asset Marketplace
BREVO_API_TIMEOUT_SECONDS=15
# EMAIL_BACKEND=config.brevo_email_backend.BrevoAPIEmailBackend
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# Local Compose with DEBUG=False may keep console mail. Staging/prod: False + Brevo/SMTP.
ALLOW_CONSOLE_EMAIL=True
DEFAULT_FROM_EMAIL=noreply@3dassetmarketplace.local
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
# Comma-separated staff inboxes (required on staging/prod when DEBUG=False).
# Operator: python manage.py check_ops_config --fail-on-warnings
PROJECT_MESSAGE_ADMIN_RECIPIENTS=
CONTACT_ADMIN_RECIPIENTS=

# --- Stripe (sandbox / test mode until Phase K launch) ---
# Use sk_test_ / pk_test_ only. Live keys belong on the production host checklist.
# Operator: manage.py check_stripe_config --require-test-mode --fail-on-warnings [--ping] [--smoke-fulfill]
STRIPE_SECRET_KEY=
STRIPE_PAYMENT_MODE=test
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# See docs/STRIPE_SANDBOX_CHECKLIST.md for webhook events + CLI forward.
# Browser E2E / Compose overlay only. Never set with sk_live_ keys.
# E2E_STRIPE_SIMULATE=True

# --- Sentry (optional; create separate Django + React projects at sentry.io) ---
# See docs/SENTRY_STAGING_CHECKLIST.md — check_sentry_config --send-test-event
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1
# Frontend DSN is baked at image build time (Vite).
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=production
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1

# --- Cloudflare R2 (recommended in Compose; leave blank only for API-only smoke tests) ---
# Both buckets required when enabling R2. See docs/R2_STAGING_CHECKLIST.md
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT_URL=
R2_PUBLIC_BUCKET=3dam-public
R2_PRIVATE_BUCKET=3dam-private
R2_PUBLIC_BASE_URL=
R2_SIGNED_URL_EXPIRY=60
# Sentry warning when one account requests this many download links in an hour (0 = off)
DOWNLOAD_ALERT_LINKS_PER_HOUR=50
# After enabling: manage.py verify_r2 [--smoke-presign] ; migrate_local_media_to_r2 ; audit_published_packages --fail-on-missing
# Compose reads these from this root .env (not backend/.env) — recreate web + worker after changes.
