# Root Compose env for Feature 13 (copy to `.env` — never commit real secrets).
# Used by docker compose; backend also reads these as process environment.
#
# Production cutover: follow docs/PRODUCTION_CHECKLIST.md
# (DEBUG=False, real SECRET_KEY, Redis, SMTP, Stripe, both R2 buckets, Sentry, TLS at proxy,
# check --deploy, backup drill, webhook test, worker + mail, rollback policy).

# --- Django / Gunicorn (web image forces DEBUG=False) ---
# Phase A2: replace placeholders before staging/prod — see docs/DEPLOY_SECRETS_STAGING_CHECKLIST.md
# Generate: openssl rand -base64 48
# Never ship the example SECRET_KEY (check_deploy_config / check --deploy will fail).
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-bytes
DEBUG=False
# Local Compose: localhost + service names. Staging/prod: public hostname(s) only (no *).
ALLOWED_HOSTS=localhost,127.0.0.1,web,frontend
# Comma-separated origins the SPA is served from (email links + CORS if API is on another host).
# Production: https://<public-spa-origin> — see docs/AUTH_STAGING_CHECKLIST.md
FRONTEND_BASE_URL=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
PUBLIC_API_BASE_URL=http://localhost:8080
# Local Compose is HTTP; set True only behind real TLS (Cloudflare / load balancer).
SECURE_SSL_REDIRECT=False
# Required when DEBUG=False on a public host (https://… SPA/API origins):
# CSRF_TRUSTED_ORIGINS=https://your-domain.example
# SECURE_HSTS_SECONDS=31536000
# When DEBUG=False, localhost FRONTEND is refused unless ALLOW_LOCALHOST_FRONTEND=True.
# Local Compose / CI e2e must set this; staging/prod must leave it False/unset.
ALLOW_LOCALHOST_FRONTEND=True
# Staging/prod gate: manage.py check_deploy_config --fail-on-warnings
#                   manage.py check --deploy

# --- PostgreSQL ---
DB_NAME=marketplace
DB_USER=marketplace
# Replace before staging/prod (not the example string; ≥12 chars).
DB_PASSWORD=change-me-db-password
DB_HOST=postgres
DB_PORT=5432
# Phase A5 backups (ops scripts — not Django settings):
#   ./backend/scripts/backup_postgres.sh
#   BACKUP_UPLOAD_R2=1 BACKUP_RETENTION_DAYS=14 ./backend/scripts/backup_postgres.sh
#   ./backend/scripts/restore_postgres_drill.sh ./backups/marketplace-….dump
# See docs/BACKUP_RESTORE_DRILL.md / PRODUCTION_CHECKLIST §2.6

# --- Redis (required when DEBUG=False) ---
# Cache / DRF throttles / checkout idempotency (DB 1).
REDIS_URL=redis://redis:6379/1
# Celery broker (DB 0). Falls back to REDIS_URL if unset.
CELERY_BROKER_URL=redis://redis:6379/0

# --- Meilisearch ---
MEILI_URL=http://meilisearch:7700
# Replace before staging/prod (≥16 chars; not this example string).
MEILI_MASTER_KEY=change-me-meili-master-key-at-least-16-chars
MEILI_ENV=production
# When DEBUG=False, MEILI_REQUIRED defaults true (healthz + public search need Meili).
# MEILI_REQUIRED=true
# Staging/prod: docker compose exec web python manage.py check_search_config --fail-on-warnings
#               docker compose exec web python manage.py reindex_search

# Frontend build args (empty VITE_API_BASE_URL = same-origin /api via Nginx; required for httpOnly refresh cookies)
# SPA administrator panel: /console (not /admin — /admin is Django admin via Nginx).
FRONTEND_PORT=8080
VITE_API_BASE_URL=
# Same Web client ID as GOOGLE_OAUTH_CLIENT_ID (leave both blank to disable Google Sign-In).
VITE_GOOGLE_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_ID=

# --- Email (console by default; staging/prod MUST use SMTP) ---
# See docs/SMTP_STAGING_CHECKLIST.md — manage.py check_email_config [--send-test-email]
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# Local Compose with DEBUG=False may keep console mail. Production: False + real SMTP.
ALLOW_CONSOLE_EMAIL=True
DEFAULT_FROM_EMAIL=noreply@3dassetmarketplace.local
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
# Comma-separated staff inboxes (required on staging/prod when DEBUG=False).
PROJECT_MESSAGE_ADMIN_RECIPIENTS=
CONTACT_ADMIN_RECIPIENTS=

# --- Stripe (sandbox / test mode until Phase K launch) ---
# Use sk_test_ / pk_test_ only. Live keys belong on the production host checklist.
# Operator: manage.py check_stripe_config --require-test-mode --fail-on-warnings [--ping]
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# See docs/STRIPE_SANDBOX_CHECKLIST.md for webhook events + CLI forward.
# Browser E2E / Compose overlay only. Never set with sk_live_ keys.
# E2E_STRIPE_SIMULATE=True

# --- Sentry (optional; create separate Django + React projects at sentry.io) ---
# See docs/SENTRY_STAGING_CHECKLIST.md — check_sentry_config --send-test-event
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1
# Frontend DSN is baked at image build time (Vite).
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=production
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1

# --- Cloudflare R2 (recommended in Compose; leave blank only for API-only smoke tests) ---
# Both buckets required when enabling R2. See docs/R2_STAGING_CHECKLIST.md
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT_URL=
R2_PUBLIC_BUCKET=3dam-public
R2_PRIVATE_BUCKET=3dam-private
R2_PUBLIC_BASE_URL=
R2_SIGNED_URL_EXPIRY=300
# After enabling: manage.py verify_r2 ; migrate_local_media_to_r2 ; audit_published_packages --fail-on-missing
